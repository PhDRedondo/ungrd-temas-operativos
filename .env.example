# App
AUTH_MODE=demo
NEXT_PUBLIC_AUTH_MODE=demo
AUTH_SECRET=cambiar-con-openssl-rand-base64-32
# En producción AUTH_SECRET es obligatorio (sin fallback).
AUTH_URL=http://localhost:3000

# ── Base de datos (RECOMENDADO: misma Supabase en local y despliegue) ──
# Así Dashboard Operativo y QuickBI (medallón) miran la misma fuente.
# Generar desde MEDALLION:  npx tsx scripts/print-vercel-database-url.ts
# DATABASE_URL=postgresql://postgres.<ref>:<PASSWORD>@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
#
# Solo offline / Docker aislado (NO alinea con QuickBI):
DATABASE_URL=postgresql://ungrd:ungrd@127.0.0.1:5432/ungrd_temas

# Rate limit global en Vercel (opcional). Sin esto se usa memoria por instancia.
# UPSTASH_REDIS_REST_URL=https://….upstash.io
# UPSTASH_REDIS_REST_TOKEN=…

# Usuario demo autorizado (no dejar vacío en prod; configurar también en Vercel)
DEMO_AUTH_EMAIL=admin@ungrd.gov.co
DEMO_AUTH_PASSWORD=UNGRD2026

# ACL: false = sin filas ACL → acceso amplio (ideal local)
# true = sin filas ACL → sin acceso (ideal Vercel/prod)
ACL_STRICT=false

# ── Seguridad (protocolo v1) ──────────────────────────────────
SECURITY_ENABLED=true
SECURITY_TRUST_PROXY=true
# En local, localhost queda en allowlist (rate laxo). En prod: false
SECURITY_ALLOW_LOCALHOST=true
SECURITY_API_RPM=300
SECURITY_AUTH_RPM=30
SECURITY_UPLOAD_RPM=20
SECURITY_HEALTH_RPM=60
SECURITY_WINDOW_MS=60000
SECURITY_BAN_THRESHOLD=20
SECURITY_BAN_MS=900000
SECURITY_MAX_BODY_MB=12

# ── Vercel / producción (configurar en el dashboard, NO en git) ──
# AUTH_URL=https://ungrd-manejo-phi.vercel.app
# AUTH_SECRET=<generar-secreto-largo>
# DEMO_AUTH_EMAIL=admin@ungrd.gov.co
# DEMO_AUTH_PASSWORD=UNGRD2026
# ACL_STRICT=true
# SECURITY_ALLOW_LOCALHOST=false
# DATABASE_URL=<misma URL pooler Session :5432 que en local>
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<solo-server-nunca-NEXT_PUBLIC>

# Solo lectura medallón (NO usar el user postgres de la app)
# MEDALLION_DATABASE_URL=postgresql://medallion_reader.vbxvqctdemtnmkifrxeo:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# Silver sync (escritura) usa DATABASE_URL de prod pooler Session :5432
# o deriva admin desde MEDALLION_DATABASE_URL (postgres.<ref> + mismo password).

# Keycloak (cuando AUTH_MODE=keycloak)
# KEYCLOAK_CLIENT_ID=ungrd-app
# KEYCLOAK_CLIENT_SECRET=ungrd-app-secret-change-me
# KEYCLOAK_ISSUER=http://localhost:8080/realms/ungrd
# AUTH_MODE=keycloak
# NEXT_PUBLIC_AUTH_MODE=keycloak

# ── Correo (Resend) ───────────────────────────────────────────
# RESEND_API_KEY=re_xxx
# Remitente verificado en Resend (también sirve REPORT_EMAIL_FROM)
# EMAIL_FROM=UNGRD Temas Operativos <noreply@su-dominio.gov.co>
# REPORT_EMAIL_FROM=UNGRD Reportes <noreply@su-dominio.gov.co>
# REPORT_EMAIL_TO=director@ungrd.gov.co,analitica@ungrd.gov.co
# CRON_SECRET=<secreto-largo-para-/api/cron/daily-briefing>

# ── QuickBI (Alibaba) — embeber tableros ──────────────────────
# Opción A (recomendada): proxy al backend SNI publicado
# React → /api/quickbi/embed-url → {UPSTREAM}/api/quickbi/embed-url
QUICKBI_UPSTREAM_BASE_URL=https://apisni.soft180.co
#
# Opción B: CreateTicket en este mismo Next.js (AccessKey Alibaba)
# QUICKBI_ACCESS_KEY_ID=
# QUICKBI_ACCESS_KEY_SECRET=
# QUICKBI_ENDPOINT=quickbi-public.us-east-1.aliyuncs.com
# QUICKBI_HOST=bi-us-east-1.alibabacloud.com
# QUICKBI_TICKET_EXPIRE_MINUTES=129600
# QUICKBI_TICKET_REFRESH_MINUTES=10080
#
# Sin A ni B: fallback a accessTicket estático del catálogo (puede expirar).
