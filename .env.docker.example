# Docker Compose — UNGRD Temas Operativos (100% local / Alibaba, sin Vercel)
# Copiar a .env.docker (gitignored) y ajustar antes de producción:
#   cp .env.docker.example .env.docker

# ── Postgres ───────────────────────────────────────────────────
# Compose offline: Postgres del stack (default abajo).
# Alibaba / alineación QuickBI: sustituir DATABASE_URL por Supabase
# pooler Session :5432 (misma URL que .env.local recomendado).
#   npx tsx scripts/print-vercel-database-url.ts
POSTGRES_USER=ungrd
POSTGRES_PASSWORD=ungrd
POSTGRES_DB=ungrd_temas
POSTGRES_PUBLISH_PORT=5432
DATABASE_URL=postgresql://ungrd:ungrd@postgres:5432/ungrd_temas

# ── App Next.js ────────────────────────────────────────────────
APP_PUBLISH_PORT=3000
# URL pública con la que abren el navegador (cambiar en Alibaba/prod)
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-docker-dev-secret-min-32-chars
AUTH_MODE=demo
NEXT_PUBLIC_AUTH_MODE=demo
DEMO_AUTH_EMAIL=admin@ungrd.gov.co
DEMO_AUTH_PASSWORD=UNGRD2026
ACL_STRICT=false
SECURITY_ENABLED=true
SECURITY_ALLOW_LOCALHOST=true

# QuickBI — proxy al backend SNI (sin AccessKey en este contenedor)
QUICKBI_UPSTREAM_BASE_URL=https://apisni.soft180.co

# Medallón (misma instancia Supabase; opcional en compose offline)
# MEDALLION_DATABASE_URL=postgresql://medallion_reader.<ref>:…@…:5432/postgres?sslmode=require

# Keycloak (perfil keycloak): AUTH_MODE=keycloak + KEYCLOAK_* en .env.docker
